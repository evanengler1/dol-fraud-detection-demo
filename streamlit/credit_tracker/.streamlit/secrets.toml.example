# Local preview only. Copy to secrets.toml (git-ignored) and fill in.
# In Snowflake the app uses its own session and ignores this file.
[connections.snowflake]
account = "<ORG>-<ACCOUNT>"
user = "<USER>"
authenticator = "externalbrowser"   # or SNOWFLAKE_JWT with private_key_file
role = "DOL_FRAUD_DEMO_ROLE"
warehouse = "DOL_FRAUD_WH"
database = "DOL_FRAUD_DEMO"
schema = "COST"
